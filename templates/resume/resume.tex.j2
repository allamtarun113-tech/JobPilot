\documentclass[11pt,letterpaper]{article}

\usepackage[letterpaper,top=0.38in,bottom=0.30in,left=0.48in,right=0.48in]{geometry}
\usepackage[T1]{fontenc}
\usepackage{mathptmx}
\usepackage{helvet}
