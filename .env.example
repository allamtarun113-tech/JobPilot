# Copy to .env and fill in. Names only - never commit real values.
JOBPILOT_ENV=dev
# Laptop worker/dispatcher + migrations. Supabase: Project Settings -> Database -> Connection string ->
# "Session pooler" (or Direct), with the driver prefix changed to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://localhost/jobpilot
# Vercel dashboard only: the "Transaction pooler" string (port 6543), same postgresql+psycopg:// prefix
DATABASE_POOLER_URL=

# Supabase Storage (resume PDFs). Project Settings -> API. Keep the service role key secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=jobpilot

# Qdrant (vectors). Empty = local embedded mode in var/qdrant
QDRANT_URL=
QDRANT_API_KEY=

# Telegram (empty token = dry-run: messages are written to var/telegram_dry_run.jsonl)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Per-connection MCP credentials (any long random strings)
MCP_TELEGRAM_DISPATCHER_KEY=
MCP_TELEGRAM_WORKER_KEY=
MCP_GMAIL_DISPATCHER_KEY=
MCP_GMAIL_WORKER_KEY=
MCP_WEB_WORKER_KEY=

# Signs short-lived Gmail send tokens (minted by the dispatcher from durable approvals)
APPROVAL_TOKEN_KEY=

# Dashboard login (TOTP). Generate with: make totp-secret
DASHBOARD_TOTP_SECRET=
DASHBOARD_SESSION_SECRET=
DASHBOARD_BASE_URL=http://127.0.0.1:8765

# LLM
OPENAI_API_KEY=

# Hosted tracing (Langfuse Cloud, OTLP)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Job sources
JSEARCH_API_KEY=
JSEARCH_HOST=jsearch.p.rapidapi.com
# Fallback jobs API when JSearch fails (Google Jobs via SerpApi)
SERPAPI_API_KEY=
# Web search uses OpenAI's web_search tool with OPENAI_API_KEY; no separate search key.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# Fernet key for the stored Gmail refresh token: make gmail-token-key
GMAIL_TOKEN_KEY=
# Development and tests: a fake in-memory Gmail for drafts and sends (any value turns it on)
GMAIL_FIXTURE_DIR=
# Encrypts database backups (make backup-key). Keep a copy somewhere other than this laptop.
BACKUP_KEY=
# Optional (threat model Option B): Ed25519 send tokens. The dispatcher holds the private signing key; the Gmail
# MCP server only the public verify key. Generate with: make approval-keys
APPROVAL_SIGNING_KEY=
APPROVAL_VERIFY_KEY=
